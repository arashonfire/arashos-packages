+void SessionManager::delaySleep() {
+    if (m_sleepDelay.isValid())
+        return;
+
+    auto bus = getSystemBus();
+    if (!bus)
+        return;
+
+    auto msg = QDBusMessage::createMethodCall(k_loginService, k_loginPath, k_loginIface, u"Inhibit"_s);
+    msg.setArguments({ u"sleep"_s, u"Caelestia"_s, u"Lock the screen first"_s, u"delay"_s });
+    const QDBusReply<QDBusUnixFileDescriptor> reply = bus->call(msg);
+    if (!reply.isValid()) {
+        qCWarning(lcSessionManager) << "Failed to delay sleep for the lock screen:" << reply.error().message();
+        return;
+    }
+    m_sleepDelay = reply.value();
+}
+
+void SessionManager::allowSleep() {
+    // Dropping the last copy of the descriptor closes it, which ends the delay.
+    if (m_aboutToSleep)
+        m_sleepDelay = QDBusUnixFileDescriptor();
+}
+
 void SessionManager::logout() {
     callSession(u"Terminate"_s);
 }
