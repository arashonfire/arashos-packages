 void SessionManager::handlePrepareForSleep(bool sleep) {
+    m_aboutToSleep = sleep;
     if (sleep) {
         emit aboutToSleep();
     } else {
+        // Woken up, or the sleep was cancelled: delay the next one too.
+        delaySleep();
         emit resumed();
     }
 }
