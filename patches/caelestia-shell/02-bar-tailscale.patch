@@ -0,0 +1,57 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Tailscale's mark, a 3×3 grid of dots, drawn rather than loaded from SVG so it
+// stays crisp at bar size (as Omarchy's widget does). Connected: the mark's
+// dots full and the rest faded. Off, signed out or not running: the whole
+// grid evenly dimmed (still 3:1 on the light themes).
+// Takes no space while Tailscale isn't installed.
+Item {
+    id: root
+
+    required property color colour
+
+    readonly property real dot: Math.round(sizer.implicitWidth * 0.2)
+    readonly property real gap: Math.round(sizer.implicitWidth * 0.08)
+
+    implicitWidth: Tailscale.installed ? sizer.implicitWidth : 0
+    implicitHeight: Tailscale.installed ? sizer.implicitHeight : 0
+    visible: Tailscale.installed
+
+    // The size of the bar's other status icons
+    MaterialIcon {
+        id: sizer
+
+        visible: false
+        text: "lan"
+    }
+
+    Grid {
+        anchors.centerIn: parent
+        columns: 3
+        spacing: root.gap
+
+        Repeater {
+            // The mark: the middle row and the bottom middle dot
+            model: [false, false, false, true, true, true, false, true, false]
+
+            Rectangle {
+                required property bool modelData
+
+                implicitWidth: root.dot
+                implicitHeight: root.dot
+                radius: root.dot / 2
+                color: root.colour
+                opacity: Tailscale.running ? (modelData ? 1 : 0.3) : 0.55
+
+                Behavior on opacity {
+                    Anim {
+                        type: Anim.DefaultEffects
+                    }
+                }
+            }
+        }
+    }
+}
