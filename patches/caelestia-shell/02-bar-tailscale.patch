--- a/services/Tailscale.qml
+++ b/services/Tailscale.qml
@@ -0,0 +1,293 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Caelestia.I18n
+
+// Tailscale in the bar (ArashOS): reads `tailscale status --json`, turns
+// Tailscale on and off, switches accounts and exit nodes. Modelled on
+// Omarchy's Tailscale bar widget (MIT). Turning it on and off without sudo
+// needs the user to be tailscale's operator, which ArashOS's setup sets
+// (arashos-install-app: tailscale up --operator=$USER).
+Singleton {
+    id: root
+
+    // false until a status check finds the tailscale command
+    property bool installed: false
+    // tailscaled answered; false when the service is stopped
+    property bool daemonRunning: false
+    // Running, Stopped, NeedsLogin, Starting, NoState
+    property string backendState: ""
+    readonly property bool running: daemonRunning && backendState === "Running"
+    readonly property bool needsLogin: daemonRunning && backendState === "NeedsLogin"
+    property string tailnet: ""
+    property string selfName: ""
+    property string selfIp: ""
+    // online peers, sorted by name: {id, name, ip, dns, os, exitNodeOption,
+    // exitNode, canReceive}
+    property var peers: []
+    property int offlineCount: 0
+    // {id, label, selected}; only read while the popout is open
+    property var accounts: []
+    // the last action's error, for the popout
+    property string error: ""
+    // the IP just copied, for a moment, so the popout can say so
+    property string copied: ""
+    readonly property bool busy: actionProc.running
+    property bool statusParsed: false
+
+    function refresh(withAccounts: bool): void {
+        if (!statusProc.running)
+            statusProc.running = true;
+        if (withAccounts && running && !accountsProc.running)
+            accountsProc.running = true;
+    }
+
+    function setUp(up: bool): void {
+        run(["tailscale", up ? "up" : "down"]);
+    }
+
+    function switchAccount(id: string): void {
+        run(["tailscale", "switch", id]);
+    }
+
+    // peer: an exit node to use, or null to stop using one
+    function setExitNode(peer: var): void {
+        run(["tailscale", "set", `--exit-node=${peer ? peer.ip : ""}`]);
+    }
+
+    // Taildrop: pick files and send them (arashos-taildrop says how it went)
+    function sendFiles(peer: var): void {
+        Quickshell.execDetached(["arashos-taildrop", "send", peer.dns || peer.ip]);
+    }
+
+    function copy(text: string): void {
+        if (!text)
+            return;
+        Quickshell.execDetached(["wl-copy", "--", text]);
+        copied = text;
+        copiedTimer.restart();
+    }
+
+    // Signing in asks questions (Tailscale or your own Headscale server), so it
+    // runs ArashOS's setup in a terminal. It also starts tailscaled.
+    function signIn(): void {
+        Quickshell.execDetached(["arashos-floating", "Tailscale", "arashos-install-app", "--setup", "tailscale"]);
+    }
+
+    // The last action: its exit code and stderr arrive in either order.
+    property int actionExit: -1
+    property var actionStderr: null
+
+    function run(command: list<string>): void {
+        if (actionProc.running)
+            return;
+        error = "";
+        actionExit = -1;
+        actionStderr = null;
+        actionProc.command = command;
+        actionProc.running = true;
+    }
+
+    function actionFinished(): void {
+        if (actionExit < 0 || actionStderr === null)
+            return;
+        const out = actionStderr;
+        actionStderr = null;
+        if (actionExit === 0) {
+            error = "";
+            refresh(true);
+            return;
+        }
+        // A bare `tailscale up` is refused when this computer was signed in
+        // with settings it doesn't repeat (a Headscale server, the operator).
+        // tailscale then prints the full command, which only restates the
+        // current settings: run that instead, once, if it is only plain
+        // --flag=value arguments (a quoted value would split wrongly).
+        const cmd = actionProc.command;
+        const full = out.split("\n").map(l => l.trim()).find(l => l.startsWith("tailscale up --")) ?? "";
+        const argv = full.split(/\s+/);
+        if (full && cmd.length === 2 && cmd[1] === "up" && argv.slice(2).every(a => /^--[a-z][a-z0-9-]*(=[^'"\s]*)?$/.test(a))) {
+            Qt.callLater(() => root.run(argv));
+            return;
+        }
+        const lines = out.trim().split("\n").filter(l => l.trim());
+        error = lines.length ? lines[lines.length - 1] : Tr.tr("That did not work.");
+        refresh(true);
+    }
+
+    // A peer's name: its host name, or for phones that call themselves
+    // "localhost", the first part of its tailnet DNS name.
+    function peerName(peer: var): string {
+        const host = peer.HostName ?? "";
+        if (host && host.toLowerCase() !== "localhost")
+            return host;
+        return (peer.DNSName ?? "").split(".")[0] || host || "?";
+    }
+
+    function ipv4(ips: var): string {
+        return (ips ?? []).find(ip => ip.indexOf(":") < 0) ?? "";
+    }
+
+    function parseStatus(text: string): void {
+        let data;
+        try {
+            data = JSON.parse(text);
+        } catch (e) {
+            return;
+        }
+        statusParsed = true;
+        installed = true;
+        daemonRunning = true;
+        backendState = data.BackendState ?? "";
+        tailnet = data.CurrentTailnet?.Name ?? "";
+        selfName = data.Self ? peerName(data.Self) : "";
+        selfIp = ipv4(data.Self?.TailscaleIPs ?? data.TailscaleIPs);
+
+        // Taildrop: the tailnet lets this computer send files, and tailscale
+        // says which devices can take them (TaildropTarget 1); daemons too old
+        // to say: the same owner's devices.
+        const fileSharing = Object.keys(data.Self?.CapMap ?? {}).concat(data.Self?.Capabilities ?? []).includes("https://tailscale.com/cap/file-sharing");
+        const selfUser = data.Self?.UserID;
+
+        const online = [];
+        let offline = 0;
+        for (const [id, p] of Object.entries(data.Peer ?? {})) {
+            // Mullvad exit nodes would bury the tailnet's own devices.
+            if ((p.DNSName ?? "").endsWith(".mullvad.ts.net."))
+                continue;
+            if (!p.Online) {
+                offline++;
+                continue;
+            }
+            online.push({
+                id: id,
+                name: peerName(p),
+                ip: ipv4(p.TailscaleIPs),
+                dns: (p.DNSName ?? "").replace(/\.$/, ""),
+                os: (p.OS ?? "").toLowerCase(),
+                exitNodeOption: p.ExitNodeOption === true,
+                exitNode: p.ExitNode === true,
+                canReceive: fileSharing && (p.TaildropTarget ? p.TaildropTarget === 1 : p.UserID === selfUser)
+            });
+        }
+        online.sort((a, b) => a.name.localeCompare(b.name));
+        peers = online;
+        offlineCount = offline;
+    }
+
+    Process {
+        id: statusProc
+
+        // Exit 127: tailscale isn't installed. Any other failure: tailscaled
+        // isn't running.
+        command: ["sh", "-c", "command -v tailscale >/dev/null || exit 127; exec tailscale status --json"]
+        environment: ({
+                LANG: "C.UTF-8",
+                LC_ALL: "C.UTF-8"
+            })
+        stdout: StdioCollector {
+            onStreamFinished: {
+                if (text.trim())
+                    root.parseStatus(text);
+            }
+        }
+        onRunningChanged: {
+            if (running)
+                root.statusParsed = false;
+        }
+        // The output may be read before or after the exit: a status that
+        // parsed wins over the exit code.
+        onExited: exitCode => { // qmllint disable signal-handler-parameters
+            if (root.statusParsed || exitCode === 0)
+                return;
+            root.installed = exitCode !== 127;
+            root.daemonRunning = false;
+            root.backendState = "";
+            root.peers = [];
+            root.accounts = [];
+        }
+    }
+
+    Process {
+        id: accountsProc
+
+        command: ["tailscale", "switch", "--list", "--json"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    root.accounts = JSON.parse(text).map(a => ({
+                                id: a.id,
+                                label: a.tailnet || a.nickname || a.account || a.id,
+                                selected: a.selected === true
+                            }));
+                } catch (e) {
+                    root.accounts = [];
+                }
+            }
+        }
+    }
+
+    Process {
+        id: actionProc
+
+        stderr: StdioCollector {
+            onStreamFinished: {
+                root.actionStderr = text;
+                root.actionFinished();
+            }
+        }
+        onExited: exitCode => { // qmllint disable signal-handler-parameters
+            root.actionExit = exitCode;
+            root.actionFinished();
+        }
+    }
+
+    // Status for the bar icon: every 30 seconds while connected, every 2
+    // minutes while off, signed out or the service is stopped, and every 3
+    // while tailscaled is starting (at login; at most a minute of that).
+    // Nothing while Tailscale isn't installed: arashos-install-app tells the
+    // shell when it installs or removes it (qs -c caelestia ipc call tailscale
+    // refresh), with a check every 10 minutes in case something else did.
+    property int startingPolls: 0
+    readonly property bool starting: backendState === "Starting" || backendState === "NoState"
+
+    onStartingChanged: {
+        if (!starting)
+            startingPolls = 0;
+    }
+
+    Timer {
+        running: true
+        repeat: true
+        triggeredOnStart: true
+        interval: {
+            if (!root.installed)
+                return 600000;
+            if (root.starting && root.startingPolls < 20)
+                return 3000;
+            return root.running ? 30000 : 120000;
