+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Caelestia.Config
+import Caelestia.I18n
+import qs.components
+import qs.components.controls
+import qs.services
+
+// Tailscale (ArashOS): on and off, this computer and the tailnet's devices
+// (click one to copy its IP, send it files), accounts and exit nodes.
+ColumnLayout {
+    id: root
+
+    width: Tokens.sizes.bar.networkWidth
+    spacing: Tokens.spacing.small
+
+    // Keep it current while it's open (the popout is unloaded when closed).
+    Timer {
+        running: true
+        repeat: true
+        triggeredOnStart: true
+        interval: 5000
+        onTriggered: Tailscale.refresh(true)
+    }
+
+    StyledText {
+        Layout.topMargin: Tokens.padding.medium
+        Layout.rightMargin: Tokens.padding.extraSmall
+        text: "Tailscale"
+        font: Tokens.font.body.builders.medium.weight(Font.Medium).build()
+    }
+
+    RowLayout {
+        visible: Tailscale.daemonRunning && !Tailscale.needsLogin
+        Layout.fillWidth: true
+        Layout.rightMargin: Tokens.padding.extraSmall
+        spacing: Tokens.spacing.medium
+
+        StyledText {
+            Layout.fillWidth: true
+            text: Tr.trCtx("Connected", "toggle label")
+        }
+
+        StyledSwitch {
+            id: onOff
+
+            enabled: !Tailscale.busy
+            onToggled: Tailscale.setUp(checked)
+        }
+
+        // Clicking breaks a plain checked binding; this keeps the switch on
+        // Tailscale's real state, also when turning it on fails.
+        Binding {
+            target: onOff
+            property: "checked"
+            value: Tailscale.running
+        }
+    }
+
+    StyledText {
+        Layout.fillWidth: true
+        Layout.rightMargin: Tokens.padding.extraSmall
+        text: {
+            if (!Tailscale.daemonRunning)
+                return Tr.tr("Tailscale isn't running on this computer.");
+            if (Tailscale.needsLogin)
+                return Tr.tr("Signed out. Sign in to connect your devices.");
+            if (!Tailscale.running)
+                return Tr.tr("Off. Turn it on to reach your devices.");
+            const exit = Tailscale.peers.find(p => p.exitNode);
+            if (exit)
+                return Tr.tr("%1, through %2").arg(Tailscale.tailnet).arg(exit.name);
+            return Tailscale.tailnet;
+        }
+        visible: text !== ""
+        wrapMode: Text.WordWrap
+        color: Colours.palette.m3onSurfaceVariant
+        font: Tokens.font.body.small
+    }
+
+    Device {
+        visible: Tailscale.running
+        icon: "computer"
+        name: Tr.tr("%1 (this computer)").arg(Tailscale.selfName)
+        ip: Tailscale.selfIp
+    }
+
+    // Accounts: only worth showing when there is more than one
+    StyledText {
+        visible: Tailscale.running && Tailscale.accounts.length > 1
+        Layout.topMargin: Tokens.spacing.small
+        text: Tr.tr("Accounts")
+        color: Colours.palette.m3onSurfaceVariant
+        font: Tokens.font.body.small
+    }
+
+    Repeater {
+        model: ScriptModel {
+            values: Tailscale.running && Tailscale.accounts.length > 1 ? Tailscale.accounts : []
+        }
+
+        Entry {
+            id: account
+
+            required property var modelData
+
+            icon: modelData.selected ? "check_circle" : "account_circle"
+            name: modelData.label
+            active: modelData.selected
+            onClicked: {
+                if (!account.modelData.selected)
+                    Tailscale.switchAccount(account.modelData.id);
+            }
+        }
+    }
+
+    StyledText {
+        visible: Tailscale.running
+        Layout.topMargin: Tokens.spacing.small
+        text: {
+            const online = Tr.trN("%n device online", "%n devices online", Tailscale.peers.length);
+            if (Tailscale.offlineCount > 0)
+                // TRANSLATORS: %1 = "N devices online", %2 = how many are offline
+                return Tr.tr("%1, %2 offline").arg(online).arg(Tailscale.offlineCount);
+            return online;
+        }
+        color: Colours.palette.m3onSurfaceVariant
+        font: Tokens.font.body.small
+    }
+
+    Repeater {
+        model: ScriptModel {
+            values: Tailscale.running ? Tailscale.peers.slice(0, 8) : []
+        }
+
+        Device {
+            id: peer
+
+            required property var modelData
+
+            icon: {
+                const os = modelData.os;
+                if (os === "android" || os === "ios")
+                    return "smartphone";
+                if (os === "macos")
+                    return "laptop_mac";
+                if (os === "windows")
+                    return "desktop_windows";
+                return "computer";
+            }
+            name: modelData.name
+            ip: modelData.ip
+            exitNodeOption: modelData.exitNodeOption
+            exitNode: modelData.exitNode
+            canReceive: modelData.canReceive
+            onSendClicked: Tailscale.sendFiles(peer.modelData)
+            onExitNodeClicked: Tailscale.setExitNode(peer.modelData.exitNode ? null : peer.modelData)
+        }
+    }
+
+    StyledText {
+        visible: Tailscale.running && Tailscale.peers.length > 8
+        Layout.leftMargin: Tokens.padding.small
+        text: Tr.tr("+ %1 more").arg(Tailscale.peers.length - 8)
+        color: Colours.palette.m3onSurfaceVariant
+        font: Tokens.font.body.small
+    }
+
+    StyledText {
+        visible: Tailscale.error !== ""
+        Layout.fillWidth: true
+        Layout.rightMargin: Tokens.padding.extraSmall
+        text: Tailscale.error
+        wrapMode: Text.WordWrap
+        color: Colours.palette.m3error
+        font: Tokens.font.body.small
+    }
+
+    IconTextButton {
+        visible: !Tailscale.daemonRunning || Tailscale.needsLogin
+        Layout.fillWidth: true
+        Layout.topMargin: Tokens.spacing.medium
+        inactiveColour: Colours.palette.m3primaryContainer
+        inactiveOnColour: Colours.palette.m3onPrimaryContainer
+        verticalPadding: Tokens.padding.extraSmall
+        text: Tailscale.needsLogin ? Tr.tr("Sign in") : Tr.tr("Start Tailscale")
+        icon: "login"
+
+        onClicked: Tailscale.signIn()
+    }
+
+    // A device: click to copy its IP. Devices that take files get a button
+    // to send some (Taildrop); exit nodes one to route this computer's
+    // traffic through them.
+    component Device: Entry {
+        id: device
+
+        property string ip
+        property bool exitNodeOption
+        property bool exitNode
+        property bool canReceive
+
+        signal exitNodeClicked
+        signal sendClicked
+
+        active: exitNode
+        detail: Tailscale.copied !== "" && Tailscale.copied === ip ? Tr.tr("Copied") : ip
+        onClicked: Tailscale.copy(ip)
+
+        Item {
+            visible: device.canReceive
+            Accessible.role: Accessible.Button
+            Accessible.name: Tr.tr("Send files")
+            implicitWidth: implicitHeight
+            implicitHeight: sendIcon.implicitHeight + Tokens.padding.extraSmall
+
+            StateLayer {
+                radius: Tokens.rounding.full
+                onClicked: device.sendClicked()
+            }
+
+            MaterialIcon {
+                id: sendIcon
+
+                anchors.centerIn: parent
+                text: "send"
+            }
+        }
+
+        StyledRect {
+            visible: device.exitNodeOption
+            Accessible.role: Accessible.Button
+            Accessible.name: device.exitNode ? Tr.tr("Stop using as exit node") : Tr.tr("Use as exit node")
+            implicitWidth: implicitHeight
+            implicitHeight: exitIcon.implicitHeight + Tokens.padding.extraSmall
+
+            radius: Tokens.rounding.full
+            color: Qt.alpha(Colours.palette.m3primary, device.exitNode ? 1 : 0)
+
+            StateLayer {
+                color: device.exitNode ? Colours.palette.m3onPrimary : Colours.palette.m3onSurface
+                disabled: Tailscale.busy
+                onClicked: device.exitNodeClicked()
+            }
+
+            MaterialIcon {
+                id: exitIcon
+
+                anchors.centerIn: parent
+                text: "public"
+                color: device.exitNode ? Colours.palette.m3onPrimary : Colours.palette.m3onSurface
+            }
+        }
+    }
+
+    component Entry: StyledRect {
+        id: row
+
+        property string icon
+        property string name
+        property string detail
+        property bool active
+        default property alias extra: content.data
+
+        signal clicked
+
+        Layout.fillWidth: true
+        implicitHeight: content.implicitHeight + Tokens.padding.small * 2
+        radius: Tokens.rounding.small
+        color: "transparent"
+
+        StateLayer {
+            disabled: Tailscale.busy
+            onClicked: row.clicked()
+        }
+
+        RowLayout {
+            id: content
+
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.verticalCenter: parent.verticalCenter
+            anchors.leftMargin: Tokens.padding.small
+            anchors.rightMargin: Tokens.padding.small
+            spacing: Tokens.spacing.small
+
+            MaterialIcon {
+                text: row.icon
+                color: row.active ? Colours.palette.m3primary : Colours.palette.m3onSurfaceVariant
+            }
+
+            StyledText {
+                Layout.leftMargin: Tokens.spacing.extraSmall
+                Layout.fillWidth: true
+                text: row.name
+                elide: Text.ElideRight
+                font: Tokens.font.body.builders.medium.weight(row.active ? Font.Medium : Font.Normal).build()
+                color: row.active ? Colours.palette.m3primary : Colours.palette.m3onSurface
+            }
+
+            StyledText {
+                visible: text !== ""
+                text: row.detail
+                color: Colours.palette.m3onSurfaceVariant
+                font: Tokens.font.body.small
+            }
+        }
+    }
+}
